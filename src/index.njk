{% set collapseID =  params.collapseID %}
{% set collapse_show = 'true' if params.collapseShow == 'show' else 'false' %}
{% set toggle_type = params.toggle_type if params.toggle_type is defined else "collapse" %}

{# CSS classes and modifiers #}
{% set class_css = params.class_css | safeParam() %}
{% set class_modifier = params.class_modifier | safeParam() %}
{% set final_class = (class_css ~ " " ~ class_modifier) | trim %}
{% set CSS = final_class | addAttribute("class", final_class != "") %}

{# attributes #}
{% set FOCUSED = params.focusable | addAttribute("focusable") %}
{% set ARIA_LABEL = params.aria_label | addAttribute("aria-label") %}
{% set ARIA_HIDDEN = params.aria_hidden | addAttribute("aria-hidden") %}
{% set TARGET = params.target | addAttribute("target") %} 
{% set type_value = params.type if params.type is defined else "button" %}
{% set url_value = "window.location.href='{{params.url | safe}}'" if params.url is defined else undefined %}
{% set URL = url_value | addAttribute("onclick") %}
{% set TYPE = type_value | addAttribute("type") %}
{% set DISABLED = params.disabled | addAttribute("disabled", params.disabled == true, { keyOnly: true }) %}


<button data-component="button.atom" 
    {{CSS | safe}}
    {{FOCUSED | safe}}
    {{ARIA_LABEL | safe}}
    {{ARIA_HIDDEN | safe}}
    {{TARGET | safe}}
    {{TYPE | safe}}
    {{URL | safe}}

    {% if collapseID %}
        data-bs-toggle="{{ toggle_type }}"
        data-bs-target="#{{collapseID}}"
        aria-controls="{{collapseID}}"
        aria-expanded="{{ collapse_show }}"
    {% endif %}
    {{DISABLED | safe}}

>
{% if params.pre_html %}
    {{params.pre_html | safe}}
{% endif %} 
{{params.text}} 
{% if params.post_html %}
    {{params.post_html | safe}}
{% endif %}
</button>